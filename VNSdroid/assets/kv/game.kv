<DrawerButton@Button>:
    font_name: './assets/jpfont.ttf'
    background_normal: ''
    background_color: 0, 0, 0, 0
    size_hint_y: None
    height: '45dp'
    canvas.before:
        Color:
            rgba: (0, 0, 0, 0) if self.state == 'normal' else (0.15, 0.15, 0.18, 0.8)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]

<ChoiceButton@Button>:
    font_name: './assets/jpfont.ttf'
    size_hint_y: None
    height: '48dp'
    background_normal: ''
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    canvas.before:
        Color:
            rgba: (0.09, 0.09, 0.1, 0.95) if self.state == 'normal' else (0.18, 0.18, 0.2, 0.95)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(15)]

<VNInterpreter>:
    canvas.after:
        Color:
            rgba: 0, 0, 0, root.transition_opacity
        Rectangle:
            pos: self.pos
            size: self.size

    FloatLayout:
        canvas.before:
            Color:
                rgba: 0, 0, 0, 1
            Rectangle:
                pos: self.pos
                size: self.size

        FloatLayout:
            id: capture_layer
            size_hint: 1, 1

            Image:
                id: bg_image
                source: root.bg_source
                allow_stretch: True
                keep_ratio: root.bg_keep_ratio

            AnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'

                RelativeLayout:
                    id: game_viewport
                    size_hint: None, None
                    size: bg_image.norm_image_size

                    FloatLayout:
                        id: sprite_layer
                        size_hint: 1, 1
                        
        FloatLayout:
            id: default_ui_layer
            opacity: root.ui_opacity
            disabled: root.ui_hidden
            size_hint: 1, 1

            AnchorLayout:
                anchor_x: 'center'
                anchor_y: 'bottom'
                size_hint: 1, 1
                padding: [0, 0, 0, 0]

                BoxLayout:
                    id: text_box_container
                    orientation: 'vertical'
                    size_hint_x: None
                    width: game_viewport.width if root.bg_keep_ratio else root.width
                    size_hint_y: None
                    height: max(dp(150), min(dialogue_label.texture_size[1] + dp(70), dp(300)))
                    padding: ['20dp', '45dp', '20dp', '25dp']
                    
                    canvas.before:
                        Color:
                            rgba: 0, 0, 0, 0.85
                        Rectangle:
                            pos: self.x, self.y
                            size: self.width, self.height - dp(35)
                        Color:
                            rgba: 0, 0, 0, 0.7
                        Rectangle:
                            pos: self.x, self.y + self.height - dp(35)
                            size: self.width, dp(4)
                        Color:
                            rgba: 0, 0, 0, 0.55
                        Rectangle:
                            pos: self.x, self.y + self.height - dp(31)
                            size: self.width, dp(4)
                        Color:
                            rgba: 0, 0, 0, 0.4
                        Rectangle:
                            pos: self.x, self.y + self.height - dp(27)
                            size: self.width, dp(4)
                        Color:
                            rgba: 0, 0, 0, 0.28
                        Rectangle:
                            pos: self.x, self.y + self.height - dp(23)
                            size: self.width, dp(3)
                        Color:
                            rgba: 0, 0, 0, 0.18
                        Rectangle:
                            pos: self.x, self.y + self.height - dp(20)
                            size: self.width, dp(3)
                        Color:
                            rgba: 0, 0, 0, 0.1
                        Rectangle:
                            pos: self.x, self.y + self.height - dp(17)
                            size: self.width, dp(3)
                        Color:
                            rgba: 0, 0, 0, 0.05
                        Rectangle:
                            pos: self.x, self.y + self.height - dp(14)
                            size: self.width, dp(3)
                        Color:
                            rgba: 0, 0, 0, 0.02
                        Rectangle:
                            pos: self.x, self.y + self.height - dp(11)
                            size: self.width, dp(3)
                        Color:
                            rgba: 0, 0, 0, 0.01
                        Rectangle:
                            pos: self.x, self.y + self.height - dp(8)
                            size: self.width, dp(3)

                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: max(self.minimum_height, self.parent.height if self.parent else 0)
                            
                            Label:
                                id: dialogue_label
                                text: root.dialogue_text
                                font_name: './assets/jpfont.ttf'
                                font_size: '16sp'
                                size_hint_y: None
                                height: self.texture_size[1]
                                halign: 'left'
                                valign: 'top'
                                text_size: self.width, None
                                color: 1, 1, 1, 1

                            Widget:
                                size_hint_y: 1

            Label:
                id: name_label
                text: root.char_name
                font_name: './assets/jpfont.ttf'
                font_size: '19sp'
                bold: True
                outline_width: 2
                outline_color: 0, 0, 0, 1
                size_hint: None, None
                height: self.texture_size[1] if self.text else 0
                width: self.texture_size[0]
                halign: 'left'
                valign: 'middle'
                color: 1, 0.85, 0.3, 1
                x: text_box_container.x + dp(20)
                y: text_box_container.top - dp(25)

            Label:
                id: indicator
                text: "▼"
                font_name: './assets/jpfont.ttf'
                font_size: '22sp'
                size_hint: None, None
                size: self.texture_size
                right: text_box_container.right - dp(20)
                y: text_box_container.y + dp(15)
                color: 1, 0.85, 0.3, 1
                opacity: 0.0

        FloatLayout:
            id: custom_ui_layer
            size_hint: 1, 1

        Button:
            background_normal: ''
            background_disabled_normal: ''
            background_color: 0, 0, 0, 0
            size_hint: 1, 1
            disabled: root.is_choosing or root.ui_hidden
            on_release: 
                root.close_drawer()
                root.next_line()

        BoxLayout:
            id: choice_layer
            orientation: 'vertical'
            size_hint: 0.8, None
            height: self.minimum_height
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            opacity: 1 if root.is_choosing else 0
            disabled: not root.is_choosing
            spacing: '10dp'

        FloatLayout:
            opacity: root.ui_opacity
            disabled: root.ui_hidden
            size_hint: 1, 1

            BoxLayout:
                id: side_drawer
                orientation: 'vertical'
                size_hint: 0.35, 1 
                pos_hint: {'x': 1.0, 'y': 0.0} 
                canvas.before:
                    Color:
                        rgba: 0.05, 0.05, 0.05, 0.98
                    Rectangle:
                        pos: self.pos
                        size: self.size

                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True
                    
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        padding: '15dp'
                        spacing: '12dp'

                        Label:
                            text: "MENU"
                            font_name: './assets/jpfont.ttf'
                            font_size: '22sp'
                            bold: True
                            size_hint_y: None
                            height: '50dp'
                            color: 1, 1, 1, 1

                        DrawerButton:
                            text: "Save Game"
                            on_release: 
                                root.close_drawer()
                                root.open_save_ui()
                        
                        DrawerButton:
                            text: "Load Game"
                            on_release: 
                                root.close_drawer()
                                root.open_load_ui()
                        
                        DrawerButton:
                            text: "Message Log"
                            on_release: 
                                root.close_drawer()
                                root.open_history()
                        
                        DrawerButton:
                            text: "Auto-Play < ON >" if root.auto_mode else "Auto-Play < OFF >"
                            on_release: 
                                root.toggle_auto()
                        
                        DrawerButton:
                            text: "In-Game Settings"
                            on_release: 
                                root.close_drawer()
                                root.open_in_game_settings()
                        
                        DrawerButton:
                            text: "Hide UI"
                            on_release: 
                                root.close_drawer()
                                root.hide_ui()
                        
                        Widget:
                            size_hint_y: None
                            height: '30dp'

                        DrawerButton:
                            text: "Quit to Menu"
                            color: 1, 0.4, 0.4, 1 
                            on_release: 
                                root.close_drawer()
                                root.exit_to_menu()

            Button:
                text: ">" if root.drawer_open else "<"
                font_name: './assets/jpfont.ttf'
                font_size: '24sp'
                size_hint: None, None
                size: '45dp', '45dp'
                x: side_drawer.x - self.width
                top: side_drawer.top - dp(10)
                background_normal: ''
                background_color: 0, 0, 0, 0
                on_release: root.toggle_drawer()
                canvas.before:
                    Color:
                        rgba: (0.05, 0.05, 0.05, 0.95) if self.state == 'normal' else (0.1, 0.1, 0.1, 0.95)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(10), 0, 0, dp(10)]

        Button:
            background_normal: ''
            background_color: 0, 0, 0, 0
            opacity: 0
            size_hint: (1, 1) if root.ui_hidden else (None, None)
            size: (0, 0) if not root.ui_hidden else self.size
            on_release: root.unhide_ui()
